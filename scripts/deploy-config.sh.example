#!/bin/bash

# QuantMesh 部署配置文件示例
# 复制此文件为 deploy-config.sh 并修改配置

# 远程服务器配置
REMOTE_HOST="your-server.com"           # 服务器地址
REMOTE_USER="deploy"                    # SSH用户名
REMOTE_PORT="22"                         # SSH端口（默认22）
REMOTE_PATH="/opt/quantmesh"            # 远程部署路径

# SSH配置
SSH_KEY="~/.ssh/id_rsa"                 # SSH私钥路径（留空使用默认）

# 服务配置
SERVICE_NAME="quantmesh"                 # systemd服务名称
HEALTH_CHECK_URL="http://localhost:28888/api/status"  # 健康检查URL

# 构建配置
USE_DOCKER_BUILD=false                  # 是否使用Docker构建（Mac环境推荐true）
