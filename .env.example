# QuantMesh — 复制为 .env 后按需填写；勿将含真实密钥的 .env 提交到版本库。
# Copy to .env and adjust; never commit secrets.

# SQLite 主库路径（无 config.yaml 时，主配置从该库的 app_config 表加载）
QUANTMESH_SQLITE_PATH=./data/quantmesh.db

# Bot 配置目录（可选）
# QUANTMESH_BOTS_DIR=./bots

# 若需禁用从数据库覆盖内存配置（仅用 YAML）：设为 0
# QUANTMESH_USE_APP_CONFIG=0

# 若使用 MySQL/Postgres 主库而非 SQLite，可设置（敏感信息建议只放 .env）
# QUANTMESH_DATABASE_DSN=
# QUANTMESH_DATABASE_TYPE=mysql
